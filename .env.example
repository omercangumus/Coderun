# ========================
# Veritabanı
# ========================

# PostgreSQL bağlantı URL'i (asyncpg sürücüsü ile)
# Örnek: postgresql+asyncpg://kullanici:sifre@localhost:5432/veritabani
DATABASE_URL=

# Redis bağlantı URL'i
# Örnek: redis://localhost:6379/0
REDIS_URL=

# ========================
# Güvenlik / JWT
# ========================

# JWT imzalama için gizli anahtar (en az 32 karakter, rastgele üretilmeli)
# Üretmek için: openssl rand -hex 32 veya python -c "import secrets; print(secrets.token_hex(32))"
# ÖNEMLİ: Production'da mutlaka güvenli bir key kullanın ve asla commit etmeyin!
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32

# JWT imzalama algoritması
ALGORITHM=HS256

# Access token geçerlilik süresi (dakika)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token geçerlilik süresi (gün)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================
# AI / Groq
# ========================

# Groq API anahtarı (ücretsiz - https://console.groq.com)
# Üretmek için: https://console.groq.com/keys adresinden yeni key oluştur
GROQ_API_KEY=

# Groq model adı
# Seçenekler: llama-3.1-70b-versatile (en güçlü), mixtral-8x7b-32768, llama-3.1-8b-instant (en hızlı)
GROQ_MODEL=llama-3.1-70b-versatile

# ========================
# AI / OpenRouter
# ========================

# OpenRouter API anahtarı (ücretsiz - https://openrouter.ai/keys)
# Kredi kartı gerekmez, meta-llama/llama-3.1-8b-instruct:free tamamen ücretsiz
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter model adı
# Ücretsiz tier: meta-llama/llama-3.1-8b-instruct:free
# Ücretli (daha güçlü): mistralai/mistral-small-3.2-24b-instruct
OPENROUTER_MODEL=mistralai/mistral-small-3.2-24b-instruct

# OpenRouter API base URL (değiştirmeyin)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter chat completions URL (değiştirmeyin)
OPENROUTER_CHAT_URL=https://openrouter.ai/api/v1/chat/completions

# OpenRouter için HTTP-Referer header (zorunlu)
OPENROUTER_SITE_URL=https://coderun.com

# OpenRouter için X-Title header (zorunlu)
OPENROUTER_SITE_NAME=Coderun

# OpenRouter istek zaman aşımı (saniye)
OPENROUTER_TIMEOUT_SECONDS=30.0

# OpenRouter maksimum token sayısı
OPENROUTER_MAX_TOKENS=512

# OpenRouter sıcaklık değeri (0.0–1.0; düşük = daha tutarlı)
OPENROUTER_TEMPERATURE=0.3

# ========================
# Uygulama
# ========================

# Çalışma ortamı: development | staging | production
ENVIRONMENT=development

# CORS için izin verilen origin'ler (JSON array formatında)
# Development için tüm origin'lere izin: "*"
# Production için spesifik origin'ler: '["https://coderun.app","https://www.coderun.app"]'
# Mobile app için Android emulator (10.0.2.2) ve iOS simulator (localhost) adresleri dahil edin
# Örnek: '["http://localhost:3000","http://10.0.2.2:8000","http://localhost:8081"]'
ALLOWED_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# Uygulama başlığı (OpenAPI dokümantasyonunda görünür)
APP_TITLE=Coderun API

# Uygulama sürümü
APP_VERSION=0.1.0

# ========================
# PostgreSQL (Docker Compose)
# ========================

# PostgreSQL kullanıcı adı
POSTGRES_USER=

# PostgreSQL şifresi
POSTGRES_PASSWORD=

# PostgreSQL veritabanı adı
POSTGRES_DB=
